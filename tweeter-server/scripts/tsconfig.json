// Compiles scripts/ (and the src/ files they import) to scripts/dist/.
// Type-check: npx tsc -p scripts --noEmit
// Run seed:   npx tsc -p scripts && node scripts/dist/scripts/seed.js
{
  "extends": "../tsconfig.json",
  "include": ["*.ts"],
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "./dist"
  }
}
